// ─────────────────────────────────────────────────────────
// CompanyOS AI — Prisma Schema
// PostgreSQL. Supabase Auth owns the `auth.users` table;
// `User` here is our app-side profile keyed by the Supabase
// auth user id (a UUID we mirror, never generate ourselves).
// ─────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ───────────── Enums ─────────────

enum RoleKey {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

enum BusinessSize {
  SOLO
  MICRO // 2-10
  SMALL // 11-50
  MEDIUM // 51-250
  LARGE // 251-1000
  ENTERPRISE // 1000+
}

enum ActivityCategory {
  AUTH
  ORGANIZATION
  COMPANY
  TEAM
  MEMBER
  BILLING
  SETTINGS
  SECURITY
  SYSTEM
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  INVITATION
  BILLING
  SYSTEM
}

// ── CEO Agent foundation enums ──

enum AgentStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum MemoryType {
  COMPANY_FACT
  STRATEGIC_GOAL
  FOUNDER_PREFERENCE
  DECISION
  REPORT_SUMMARY
  BUSINESS_EVENT
  INSIGHT
  TASK_HISTORY
}

enum ReportStatus {
  DRAFT
  GENERATING
  COMPLETED
  FAILED
}

// ── Sales Agent / CRM enums (Phase 7) ──

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum SalesTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum CommunicationChannel {
  EMAIL
  CALL
  MEETING
  NOTE
  SMS
}

enum SalesDocumentKind {
  QUOTATION
  PROPOSAL
}

enum SalesDocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

// Shared across agent types (CEO today, Sales as of Phase 7) — one
// approval lifecycle for any sensitive AI-proposed action.
enum ApprovalStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXECUTED
  FAILED
}

// ───────────── Core identity ─────────────

model User {
  id            String   @id @db.Uuid // mirrors Supabase auth.users.id
  email         String   @unique
  fullName      String?
  avatarUrl     String?
  jobTitle      String?
  phone         String?
  timezone      String   @default("UTC")
  locale        String   @default("en")
  emailVerified Boolean  @default(false)
  lastLoginAt   DateTime?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships      Membership[]
  sentInvitations  Invitation[]     @relation("InvitationInviter")
  activityLogs     ActivityLog[]
  notifications    Notification[]
  ownedOrgs        Organization[]   @relation("OrganizationOwner")

  // Phase 7 — Sales Agent / CRM back-relations
  leadsAssigned           Lead[]             @relation("LeadAssignedTo")
  dealsOwned              Deal[]             @relation("DealSalesOwner")
  salesTasksAssigned      SalesTask[]        @relation("SalesTaskAssignedTo")
  salesTasksCreated       SalesTask[]        @relation("SalesTaskCreatedBy")
  followUpsCreated        FollowUp[]         @relation("FollowUpCreatedBy")
  communicationLogsMade   CommunicationLog[] @relation("CommunicationLogCreatedBy")
  salesDocumentsCreated   SalesDocument[]    @relation("SalesDocumentCreatedBy")
  approvalRequestsMade    ApprovalRequest[]  @relation("ApprovalRequestedBy")
  approvalRequestsReviewed ApprovalRequest[] @relation("ApprovalReviewedBy")

  @@map("users")
}

// ───────────── Organizations (tenants) ─────────────

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  logoUrl   String?
  ownerId   String   @db.Uuid
  owner     User     @relation("OrganizationOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company       Company?
  teams         Team[]
  memberships   Membership[]
  invitations   Invitation[]
  roles         Role[]
  settings      OrganizationSettings?
  activityLogs  ActivityLog[]
  notifications Notification[]

  agents           Agent[]
  executiveReports ExecutiveReport[]

  // Phase 7 — Sales Agent / CRM back-relations
  crmCompanies      CrmCompany[]
  pipelineStages    PipelineStage[]
  leads             Lead[]
  contacts          Contact[]
  deals             Deal[]
  salesTasks        SalesTask[]
  followUps         FollowUp[]
  communicationLogs CommunicationLog[]
  salesDocuments    SalesDocument[]
  approvalRequests  ApprovalRequest[]
  agentActionLogs   AgentActionLog[]

  @@index([ownerId])
  @@map("organizations")
}

model OrganizationSettings {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @unique @db.Uuid
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  brandVoice            String?
  defaultTimezone        String   @default("UTC")
  allowPublicSignup      Boolean  @default(false)
  requireTwoFactor       Boolean  @default(false)
  notifyOnNewMember      Boolean  @default(true)
  notifyOnBillingEvents  Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("organization_settings")
}

// ───────────── Company profile (onboarding) ─────────────

model Company {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @unique @db.Uuid
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name            String
  industry        String
  website         String?
  businessSize    BusinessSize
  mission         String?      @db.Text
  vision          String?      @db.Text
  goals           String[]     @default([])
  products        String[]     @default([])
  services        String[]     @default([])
  targetCustomers String?      @db.Text
  competitors     String[]     @default([])
  brandVoice      String?      @db.Text
  employeeCount   Int?

  documents       CompanyDocument[]

  onboardingStep      Int      @default(0)
  onboardingCompleted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("companies")
}

model CompanyDocument {
  id         String   @id @default(uuid()) @db.Uuid
  companyId  String   @db.Uuid
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fileName   String
  fileUrl    String
  fileType   String
  fileSizeKb Int
  uploadedAt DateTime @default(now())

  @@index([companyId])
  @@map("company_documents")
}

// ───────────── Teams & membership ─────────────

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  members TeamMember[]

  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id           String   @id @default(uuid()) @db.Uuid
  teamId       String   @db.Uuid
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membershipId String   @db.Uuid
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  joinedAt     DateTime @default(now())

  @@unique([teamId, membershipId])
  @@map("team_members")
}

// Membership links a User to an Organization with a Role (many-to-many + role)
model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  roleId         String       @db.Uuid
  role           Role         @relation(fields: [roleId], references: [id])
  isActive       Boolean      @default(true)
  joinedAt       DateTime     @default(now())

  teams TeamMember[]

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("memberships")
}

// ───────────── RBAC ─────────────

model Role {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            RoleKey
  name           String
  description    String?
  isSystem       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  memberships Membership[]
  permissions RolePermission[]

  @@unique([organizationId, key])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // e.g. "company.edit", "billing.manage"
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ───────────── Invitations ─────────────

model Invitation {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  roleKey        RoleKey           @default(MEMBER)
  status         InvitationStatus  @default(PENDING)
  token          String            @unique
  invitedById    String            @db.Uuid
  invitedBy      User              @relation("InvitationInviter", fields: [invitedById], references: [id])
  expiresAt      DateTime
  createdAt      DateTime          @default(now())

  @@index([organizationId])
  @@index([email])
  @@map("invitations")
}

// ───────────── Activity & notifications ─────────────

model ActivityLog {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        String?           @db.Uuid
  actor          User?             @relation(fields: [actorId], references: [id])
  category       ActivityCategory
  action         String // e.g. "member.invited", "company.updated"
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime          @default(now())

  @@index([organizationId, createdAt])
  @@index([actorId])
  @@map("activity_logs")
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String           @db.Uuid
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           NotificationType @default(INFO)
  title          String
  message        String
  isRead         Boolean          @default(false)
  actionUrl      String?
  createdAt      DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ═════════════════════════════════════════════════════════
// CEO Agent foundation (Phase 6)
// Only the CEO Agent is operational. This schema is written
// to allow future specialized agents to plug in later without
// a rewrite, but no other agent types are implemented yet —
// see AgentMemory metadata below for how that stays true.
// ═════════════════════════════════════════════════════════

model Agent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Plain string, not an enum — a future agent type (e.g. "SALES") can be
  // introduced without a schema migration. "CEO" and, as of Phase 7,
  // "SALES" are the app-created values today.
  type   String      @default("CEO")
  name   String      @default("CEO Agent")
  status AgentStatus @default(ACTIVE)

  // Optional override of the active System Prompt template's content
  // for this specific organization. Null means "use the template as-is."
  systemPromptOverride String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memories AgentMemory[]
  reports  ExecutiveReport[]

  // Phase 7 — Sales Agent back-relations
  approvalRequests ApprovalRequest[]
  actionLogs       AgentActionLog[]

  @@unique([organizationId, type])
  @@map("agents")
}

model AgentMemory {
  id             String   @id @default(uuid()) @db.Uuid
  // Plain scalar, not a Prisma relation — organization scoping is enforced
  // via the agent relation below; this field exists for fast, direct
  // filtering without an extra join.
  organizationId String   @db.Uuid
  agentId        String   @db.Uuid
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  type       MemoryType
  content    String     @db.Text
  importance Int        @default(3) // 1 (low) – 5 (critical)
  confidence Int        @default(5) // 1 (uncertain) – 5 (certain)
  sourceRef  String?    // e.g. a knowledge_documents id, an executive_reports id, or "user_stated"
  createdBy  String?    @db.Uuid // userId, if a person stated this directly

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, agentId, type])
  @@map("agent_memories")
}

model PromptTemplate {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  // e.g. "ceo_system", "executive_report", "executive_analysis",
  // "company_overview", "strategic_planning", "risk_analysis",
  // "kpi_analysis", "decision_summary", plus Phase 7 sales purposes
  purpose     String
  agentType   String  @default("CEO")
  description String?
  content     String  @db.Text
  version     Int     @default(1)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([purpose, agentType, version])
  @@map("prompt_templates")
}

model ExecutiveReport {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentId        String       @db.Uuid
  agent          Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  generatedBy     String       @db.Uuid // userId who requested it
  title           String
  reportingPeriod String?
  status          ReportStatus @default(DRAFT)
  summary         String?      @db.Text
  errorMessage    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sections ReportSection[]

  @@index([organizationId, createdAt])
  @@map("executive_reports")
}

model ReportSection {
  id       String          @id @default(uuid()) @db.Uuid
  reportId String          @db.Uuid
  report   ExecutiveReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  title       String
  // e.g. "SUMMARY", "STATUS", "GOALS", "KPI", "SALES", "CUSTOMER",
  // "MARKETING", "FINANCIAL", "OPERATIONAL", "RISK", "OPPORTUNITY",
  // "DECISION", "ACTION", "DATA_GAP"
  sectionType String
  content     String          @db.Text
  priority    Int             @default(3)
  sourceRefs  String[]        @default([])
  order       Int             @default(0)

  @@index([reportId, order])
  @@map("report_sections")
}

// ═════════════════════════════════════════════════════════
// Sales Agent / CRM (Phase 7)
// Schema below matches the live database exactly — these
// tables were already created directly in Supabase (outside
// this schema file) before this file was updated to describe
// them. Field names, types, and enum values are taken from
// the real table definitions, not designed independently.
// ═════════════════════════════════════════════════════════

model CrmCompany {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name     String
  industry String?
  website  String?
  notes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads    Lead[]
  contacts Contact[]
  deals    Deal[]

  @@index([organizationId])
  @@map("crm_companies")
}

model PipelineStage {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name   String
  order  Int     @default(0)
  isWon  Boolean @default(false)
  isLost Boolean @default(false)

  createdAt DateTime @default(now())

  deals Deal[]

  @@index([organizationId])
  @@map("pipeline_stages")
}

model Lead {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  crmCompanyId String?     @db.Uuid
  crmCompany   CrmCompany? @relation(fields: [crmCompanyId], references: [id], onDelete: SetNull)

  name              String
  email             String?
  phone             String?
  jobTitle          String?
  source            String?
  status            LeadStatus @default(NEW)
  score             Int        @default(0)
  aiConfidenceScore Int?
  notes             String?    @db.Text

  assignedToUserId String? @db.Uuid
  assignedToUser   User?   @relation("LeadAssignedTo", fields: [assignedToUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts          Contact[]
  deals             Deal[]
  salesTasks        SalesTask[]
  followUps         FollowUp[]
  communicationLogs CommunicationLog[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("leads")
}

model Contact {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  crmCompanyId String?     @db.Uuid
  crmCompany   CrmCompany? @relation(fields: [crmCompanyId], references: [id], onDelete: SetNull)
  leadId       String?     @db.Uuid
  lead         Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)

  name     String
  email    String?
  phone    String?
  jobTitle String?
  notes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals             Deal[]
  followUps         FollowUp[]
  communicationLogs CommunicationLog[]

  @@index([organizationId])
  @@map("contacts")
}

model Deal {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title String

  leadId       String?        @db.Uuid
  lead         Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contactId    String?        @db.Uuid
  contact      Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  crmCompanyId String?        @db.Uuid
  crmCompany   CrmCompany?    @relation(fields: [crmCompanyId], references: [id], onDelete: SetNull)
  pipelineStageId String?     @db.Uuid
  pipelineStage   PipelineStage? @relation(fields: [pipelineStageId], references: [id])

  value    Decimal?   @db.Decimal
  currency String     @default("USD")
  status   DealStatus @default(OPEN)

  expectedCloseDate DateTime?
  actualCloseDate   DateTime?
  aiConfidenceScore Int?
  lostReason        String?   @db.Text

  salesOwnerId String? @db.Uuid
  salesOwner   User?   @relation("DealSalesOwner", fields: [salesOwnerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesTasks        SalesTask[]
  followUps         FollowUp[]
  communicationLogs CommunicationLog[]
  salesDocuments    SalesDocument[]

  @@index([organizationId])
  @@map("deals")
}

model SalesTask {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dealId String? @db.Uuid
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  leadId String? @db.Uuid
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  title       String
  description String?         @db.Text
  dueDate     DateTime?
  status      SalesTaskStatus @default(TODO)

  assignedToUserId String? @db.Uuid
  assignedToUser   User?   @relation("SalesTaskAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy        String? @db.Uuid
  createdByUser    User?   @relation("SalesTaskCreatedBy", fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("sales_tasks")
}

model FollowUp {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dealId    String? @db.Uuid
  deal      Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  leadId    String? @db.Uuid
  lead      Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId String? @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  dueDate   DateTime
  notes     String?  @db.Text
  completed Boolean  @default(false)

  createdBy     String? @db.Uuid
  createdByUser User?   @relation("FollowUpCreatedBy", fields: [createdBy], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@map("follow_ups")
}

model CommunicationLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dealId    String?  @db.Uuid
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  leadId    String?  @db.Uuid
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contactId String?  @db.Uuid
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  channel   CommunicationChannel
  direction String? // "INBOUND" | "OUTBOUND" — plain string in the real table, not an enum
  content   String  @db.Text

  occurredAt DateTime @default(now())

  createdBy     String? @db.Uuid
  createdByUser User?   @relation("CommunicationLogCreatedBy", fields: [createdBy], references: [id])

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@map("communication_logs")
}

model SalesDocument {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dealId String? @db.Uuid
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  kind       SalesDocumentKind
  title      String
  content    String              @db.Text
  totalValue Decimal?            @db.Decimal
  status     SalesDocumentStatus @default(DRAFT)

  createdBy     String? @db.Uuid
  createdByUser User?   @relation("SalesDocumentCreatedBy", fields: [createdBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@map("sales_documents")
}

// Shared across agent types — a Sales Agent request and a future agent's
// request both live here, distinguished by agentId + actionType.
model ApprovalRequest {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  agentId String @db.Uuid
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  actionType     String
  proposedAction Json
  status         ApprovalStatus @default(PENDING_APPROVAL)
  reason         String?        @db.Text
  result         Json?

  requestedBy     String? @db.Uuid
  requestedByUser User?   @relation("ApprovalRequestedBy", fields: [requestedBy], references: [id])
  reviewedBy      String? @db.Uuid
  reviewedByUser  User?   @relation("ApprovalReviewedBy", fields: [reviewedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@map("approval_requests")
}

// The audit trail every AI agent action writes to (Agent, Action, Time,
// Reason, Input, Output, Approval, Result) — separate from the older
// ActivityLog, which covers human/system organizational events.
model AgentActionLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  agentId String @db.Uuid
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  action         String
  reason         String?         @db.Text
  input          Json?
  output         Json?
  approvalStatus ApprovalStatus?
  result         String?         @db.Text

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@map("agent_action_logs")
}
