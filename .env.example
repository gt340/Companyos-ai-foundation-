# ─────────────────────────────────────────────
# CompanyOS AI — Environment Variables
# Copy this file to .env.local for local dev
# ─────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# PostgreSQL (used by Prisma)
# Vercel Postgres (Neon-backed): after creating the database in the
# Vercel dashboard's Storage tab and connecting it to this project,
# Vercel injects POSTGRES_PRISMA_URL and POSTGRES_URL_NON_POOLING.
# Set DATABASE_URL to the value of POSTGRES_PRISMA_URL (pooled,
# includes ?pgbouncer=true — used at runtime) and DIRECT_URL to the
# value of POSTGRES_URL_NON_POOLING (used only for migrations).
DATABASE_URL="postgresql://companyos:companyos@localhost:5432/companyos_ai?schema=public"
DIRECT_URL="postgresql://companyos:companyos@localhost:5432/companyos_ai?schema=public"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Security
CSRF_SECRET="replace-with-a-32-byte-random-string"
SESSION_COOKIE_NAME="companyos_session"

# Email (transactional — used by Supabase or a provider of your choice)
EMAIL_FROM="CompanyOS <no-reply@companyos.ai>"
